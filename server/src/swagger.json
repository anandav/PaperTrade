{
  "openapi": "3.0.0",
  "info": {
    "title": "PaperTrade API",
    "version": "1.0.0",
    "description": "API for the PaperTrade application"
  },
  "paths": {
    "/auth/b2c/login": {
      "get": {
        "summary": "Start SSO login (B2C or CIAM, based on AUTH_PROVIDER)",
        "tags": ["Auth"],
        "security": [],
        "responses": {
          "302": {
            "description": "Redirect to the identity provider"
          }
        }
      }
    },
    "/auth/b2c/logout": {
      "get": {
        "summary": "Log out and redirect to the identity provider's logout endpoint",
        "tags": ["Auth"],
        "security": [],
        "responses": {
          "302": {
            "description": "Redirect to the identity provider logout page"
          }
        }
      }
    },
    "/auth/b2c/resetpassword": {
      "get": {
        "summary": "Start the B2C password reset policy flow",
        "tags": ["Auth"],
        "security": [],
        "responses": {
          "302": {
            "description": "Redirect to the identity provider"
          }
        }
      }
    },
    "/auth/b2c/callback": {
      "get": {
        "summary": "B2C OAuth callback, issues app JWT and redirects to the client",
        "tags": ["Auth"],
        "security": [],
        "parameters": [
          {
            "name": "code",
            "in": "query",
            "schema": { "type": "string" }
          }
        ],
        "responses": {
          "302": {
            "description": "Redirect to the client with token and refreshToken query params"
          }
        }
      }
    },
    "/auth/b2c/refresh": {
      "post": {
        "summary": "Exchange a refresh token for a new access token",
        "tags": ["Auth"],
        "security": [],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "properties": {
                  "refreshToken": {
                    "type": "string"
                  }
                }
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "New token and refreshToken"
          },
          "401": {
            "description": "Invalid or expired refresh token"
          }
        }
      }
    },
    "/auth/ciam/callback": {
      "get": {
        "summary": "CIAM OAuth callback, issues app JWT and redirects to the client",
        "tags": ["Auth"],
        "security": [],
        "parameters": [
          {
            "name": "code",
            "in": "query",
            "schema": { "type": "string" }
          }
        ],
        "responses": {
          "302": {
            "description": "Redirect to the client with token and refreshToken query params"
          }
        }
      }
    },
    "/portfolio": {
      "get": {
        "summary": "Get all portfolios",
        "responses": {
          "200": {
            "description": "A list of portfolios"
          }
        }
      }
    },
    "/portfolio/find": {
      "post": {
        "summary": "Find portfolios by a specific field",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "properties": {
                  "fieldName": {
                    "type": "string"
                  },
                  "fieldValue": {
                    "type": "string"
                  }
                }
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "A list of matching portfolios"
          }
        }
      }
    },
    "/portfolio/save": {
      "post": {
        "summary": "Save a portfolio",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/Portfolio"
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "The saved portfolio"
          }
        }
      }
    },
    "/portfolio/saveall": {
      "post": {
        "summary": "Save all portfolios",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "array",
                "items": {
                  "$ref": "#/components/schemas/Portfolio"
                }
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "The saved portfolios"
          }
        }
      }
    },
    "/portfolio/delete": {
      "post": {
        "summary": "Delete a portfolio",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "properties": {
                  "_id": {
                    "type": "string"
                  }
                }
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "The deletion status"
          }
        }
      }
    },
    "/strategy/findusingportfolioid": {
      "post": {
        "summary": "Find strategies by portfolio ID",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "properties": {
                  "fieldName": {
                    "type": "string"
                  },
                  "fieldValue": {
                    "type": "string"
                  }
                }
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "A list of matching strategies"
          }
        }
      }
    },
    "/strategy/save": {
      "post": {
        "summary": "Save a strategy",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/Strategy"
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "The saved strategy"
          }
        }
      }
    },
    "/strategy/delete": {
      "post": {
        "summary": "Delete a strategy",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "properties": {
                  "_id": {
                    "type": "string"
                  }
                }
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "The deletion status"
          }
        }
      }
    },
    "/trade/save": {
      "post": {
        "summary": "Save a trade",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/Trade"
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "The saved trade"
          }
        }
      }
    },
    "/trade/delete": {
      "post": {
        "summary": "Delete a trade",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "properties": {
                  "tid": {
                    "type": "string"
                  }
                }
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "The deletion status"
          }
        }
      }
    },
    "/splitplan": {
      "get": {
        "summary": "Get all equity split plans for the user",
        "responses": {
          "200": {
            "description": "A list of split plans"
          }
        }
      }
    },
    "/splitplan/save": {
      "post": {
        "summary": "Create or update an equity split plan",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/SplitPlan"
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "The saved plan and the updated plan list"
          }
        }
      }
    },
    "/splitplan/delete": {
      "post": {
        "summary": "Delete an equity split plan",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "properties": {
                  "_id": {
                    "type": "string"
                  }
                }
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "The updated plan list"
          }
        }
      }
    },
    "/splitplan/quotes": {
      "post": {
        "summary": "Get NSE last traded prices for equity symbols",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "properties": {
                  "symbols": {
                    "type": "array",
                    "items": {
                      "type": "string"
                    }
                  }
                }
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "A quote per symbol with lastPrice or an error"
          },
          "503": {
            "description": "Live data API is disabled"
          }
        }
      }
    },
    "/data": {
      "post": {
        "summary": "Proxy quote/reference data from the configured exchange (NSE or CBOE)",
        "description": "Disabled and returns 404 unless ENABLE_DATAAPI=true.",
        "tags": ["Data"],
        "security": [],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "properties": {
                  "action": {
                    "type": "string",
                    "description": "e.g. init, updateltp, updateexit, updateall, getexpiries"
                  },
                  "portfolio": {
                    "type": "object",
                    "description": "Portfolio containing the exchange (nse or cboe)"
                  },
                  "strategy": {
                    "$ref": "#/components/schemas/Strategy"
                  }
                }
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Exchange metadata (action=init) or the strategy updated with live quote data"
          }
        }
      }
    }
  },
  "components": {
    "schemas": {
      "Portfolio": {
        "type": "object",
        "properties": {
          "_id": {
            "type": "string"
          },
          "name": {
            "type": "string"
          },
          "exchange": {
            "type": "string"
          },
          "openingbalance": {
            "type": "number"
          },
          "description": {
            "type": "string"
          },
          "createdon": {
            "type": "string",
            "format": "date-time"
          },
          "updateui": {
            "type": "boolean"
          }
        }
      },
      "Strategy": {
        "type": "object",
        "properties": {
          "_id": {
            "type": "string"
          },
          "portfolio": {
            "type": "string"
          },
          "name": {
            "type": "string"
          },
          "description": {
            "type": "string"
          },
          "symbol": {
            "type": "string"
          },
          "symboltype": {
            "type": "string"
          },
          "lotsize": {
            "type": "number"
          },
          "expiry": {
            "type": "string",
            "format": "date-time"
          },
          "strikepricestep": {
            "type": "number"
          },
          "isarchive": {
            "type": "boolean"
          },
          "hidechart": {
            "type": "boolean"
          },
          "ismultiplesymbol": {
            "type": "boolean"
          },
          "trades": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/Trade"
            }
          },
          "createdon": {
            "type": "string",
            "format": "date-time"
          }
        }
      },
      "SplitPlan": {
        "type": "object",
        "properties": {
          "_id": {
            "type": "string"
          },
          "name": {
            "type": "string"
          },
          "amount": {
            "type": "number"
          },
          "useleftover": {
            "type": "boolean"
          },
          "items": {
            "type": "array",
            "items": {
              "type": "object",
              "properties": {
                "symbol": {
                  "type": "string"
                },
                "price": {
                  "type": "number"
                },
                "lasttradedprice": {
                  "type": "number"
                },
                "included": {
                  "type": "boolean"
                }
              }
            }
          }
        }
      },
      "Trade": {
        "type": "object",
        "properties": {
          "sid": {
            "type": "string"
          },
          "_id": {
            "type": "string"
          },
          "symbol": {
            "type": "string"
          },
          "lotsize": {
            "type": "number"
          },
          "buyorsell": {
            "type": "string"
          },
          "tradetype": {
            "type": "string"
          },
          "quantity": {
            "type": "number"
          },
          "selectedstrike": {
            "type": "number"
          },
          "price": {
            "type": "number"
          },
          "lasttradedprice": {
            "type": "number"
          },
          "isexit": {
            "type": "boolean"
          },
          "partnerid": {
            "type": "string"
          },
          "note": {
            "type": "string"
          },
          "group": {
            "type": "string"
          },
          "strikepricemin": {
            "type": "number"
          },
          "strikepricemax": {
            "type": "number"
          },
          "strikepricestep": {
            "type": "number"
          },
          "order": {
            "type": "number"
          },
          "color": {
            "type": "string"
          },
          "createdon": {
            "type": "string",
            "format": "date-time"
          },
          "modifiedon": {
            "type": "string",
            "format": "date-time"
          }
        }
      }
    },
    "securitySchemes": {
      "bearerAuth": {
        "type": "http",
        "scheme": "bearer",
        "bearerFormat": "JWT"
      }
    }
  },
  "security": [
    {
      "bearerAuth": []
    }
  ]
}