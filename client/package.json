{
  "name": "papertrade-client",
  "version": "0.5.0",
  "private": true,
  "description": "Papper Trade Client.",
  "scripts": {
    "dev": "vue-cli-service serve",
    "devcss": "postcss src/tailwind.css -o public/tailwind.css",
    "devcss2": "tailwindcss build -i src/tailwind.css -o myindex.css",
    "serve": "vue-cli-service serve",
    "build": "node scripts/generate-config.js && vue-cli-service build",
    "build:css": "postcss src/tailwind.css -o public/tailwind.css",
    "lint": "vue-cli-service lint"
  },
  "dependencies": {
    "@tailwindcss/forms": "^0.3.4",
    "axios": "^1.18.1",
    "core-js": "^3.6.4",
    "d3": "^7.6.1",
    "dayjs": "^1.10.7",
    "env-paths": "^3.0.0",
    "vue": "^3.0.0",
    "vue-router": "^4.5.0",
    "vuex": "^4.1.0"
  },
  "devDependencies": {
    "@vue/cli-plugin-babel": "~4.5.19",
    "@vue/cli-plugin-eslint": "~4.5.19",
    "@vue/cli-plugin-router": "~4.5.19",
    "@vue/cli-plugin-vuex": "~4.5.19",
    "@vue/cli-service": "~4.5.19",
    "autoprefixer": "^9.8.6",
    "babel-eslint": "^10.1.0",
    "eslint": "^6.7.2",
    "eslint-plugin-vue": "^6.2.2",
    "postcss": "^8.5.18",
    "tailwindcss": "npm:@tailwindcss/postcss7-compat@^2.2.9",
    "vue-template-compiler": "^2.6.12"
  },
  "eslintConfig": {
    "root": true,
    "env": {
      "node": true
    },
    "extends": [
      "plugin:vue/essential",
      "eslint:recommended"
    ],
    "parserOptions": {
      "parser": "babel-eslint"
    },
    "rules": {}
  },
  "browserslist": [
    "> 1%",
    "last 2 versions",
    "not dead"
  ],
  "author": "Anand.AV",
  "license": "UNLICENSED",
  "overrides": {
    "ejs": "3.1.10",
    "pbkdf2": "3.1.3",
    "sha.js": "2.4.12",
    "shell-quote": "1.9.0",
    "websocket-driver": "0.7.5",
    "lodash": "4.18.1",
    "node-forge": "1.4.0",
    "brace-expansion": "1.1.16",
    "minimatch": "3.1.4",
    "json5": "1.0.2",
    "js-yaml": "3.15.0",
    "braces": "3.0.3",
    "micromatch": "4.0.8",
    "flatted": "3.4.2",
    "cross-spawn": "7.0.6",
    "form-data": "4.0.6",
    "nth-check": "2.1.1",
    "picomatch": "2.3.2",
    "path-to-regexp": "0.1.13",
    "express": "4.22.2",
    "ws": "6.2.4",
    "http-proxy-middleware": "2.0.10",
    "tmp": "0.2.7",
    "serialize-javascript": "7.0.5",
    "dns-packet": "5.6.1",
    "@babel/core": "7.29.6",
    "@babel/plugin-transform-modules-systemjs": "7.29.4",
    "loader-utils": "1.4.2",
    "launch-editor": "2.14.1",
    "on-headers": "1.1.0",
    "yaml": "1.10.3",
    "qs": "6.15.3",
    "tough-cookie": "4.1.3",
    "babel-loader": {
      "loader-utils": "2.0.4"
